{
  "name": "visual-learn",
  "private": true,
  "version": "0.4.0",
  "description": "用于扫描本地学习笔记、阅读 Markdown 并追踪完成进度的 Electron 桌面应用",
  "productName": "Visual Learn",
  "author": "imber",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imberZsk/visual-learn.git"
  },
  "homepage": "https://imber-visual-docs.netlify.app/visual-learn",
  "bugs": {
    "url": "https://github.com/imberZsk/visual-learn/issues"
  },
  "keywords": [
    "electron",
    "learning",
    "markdown",
    "react",
    "vite",
    "desktop"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev:vite": "node scripts/vite-dev.mjs",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "dev": "node scripts/dev.mjs",
    "build:ui": "tsc && vite build",
    "build": "pnpm run build:ui",
    "preview": "vite preview",
    "start": "pnpm run build:ui && cross-env NODE_ENV=production electron .",
    "test": "vitest run",
    "test:e2e": "pnpm run build:ui && playwright test",
    "test:e2e:headed": "pnpm run build:ui && playwright test --headed",
    "test:e2e:ui": "pnpm run build:ui && playwright test --ui",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:boot": "node scripts/verify-boot.mjs",
    "dist": "pnpm run build:ui && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --mac --arm64 --publish never",
    "dist:win": "pnpm run build:ui && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --win --x64 --publish never",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "antd": "^6.5.1",
    "dayjs": "^1.11.21",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "electron-updater": "^6.8.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.imber.visual-learn",
    "productName": "Visual Learn",
    "publish": [
      {
        "provider": "github",
        "owner": "imberZsk",
        "repo": "visual-learn"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "src/core/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "artifactName": "VisualLearn-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": "arm64"
        },
        {
          "target": "zip",
          "arch": "arm64"
        }
      ],
      "category": "public.app-category.education",
      "identity": null
    },
    "dmg": {
      "title": "Visual Learn ${version}"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": "x64"
        },
        {
          "target": "portable",
          "arch": "x64"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "VisualLearn-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "VisualLearn-${version}-portable.${ext}"
    }
  }
}
